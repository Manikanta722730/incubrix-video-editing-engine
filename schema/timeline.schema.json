{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://incubrix.com/schemas/timeline.schema.json",
  "title": "IncuBrixContentAnchoredTimeline",
  "description": "Deterministic, content-anchored video timeline where edits attach to transcript tokens rather than clock timestamps.",
  "type": "object",
  "required": [
    "version",
    "timeline_id",
    "source_media",
    "transcript",
    "tracks",
    "edit_history",
    "derived_timing"
  ],
  "properties": {
    "version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "timeline_id": {
      "type": "string",
      "format": "uuid"
    },
    "source_media": {
      "type": "object",
      "required": ["source_id", "file_name", "duration_s", "fps", "width", "height", "has_audio", "source_sha256"],
      "properties": {
        "source_id": { "type": "string" },
        "file_name": { "type": "string" },
        "duration_s": { "type": "number", "minimum": 0 },
        "fps": { "type": "number", "minimum": 1 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "has_audio": { "type": "boolean" },
        "source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "storage_url": { "type": "string" }
      }
    },
    "transcript": {
      "type": "object",
      "required": ["words", "speakers"],
      "properties": {
        "words": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "text", "start_s", "end_s", "speaker", "confidence"],
            "properties": {
              "id": { "type": "string" },
              "text": { "type": "string" },
              "start_s": { "type": "number", "minimum": 0 },
              "end_s": { "type": "number", "minimum": 0 },
              "speaker": { "type": "string" },
              "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
              "is_filler": { "type": "boolean" },
              "low_confidence": { "type": "boolean" }
            }
          }
        },
        "speakers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "language": { "type": "string" }
      }
    },
    "tracks": {
      "type": "object",
      "required": ["video_track", "audio_track", "caption_track"],
      "properties": {
        "video_track": {
          "type": "object",
          "required": ["clips"],
          "properties": {
            "clips": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["clip_id", "source_start_s", "source_end_s", "speed_factor", "word_ids"],
                "properties": {
                  "clip_id": { "type": "string" },
                  "source_start_s": { "type": "number", "minimum": 0 },
                  "source_end_s": { "type": "number", "minimum": 0 },
                  "speed_factor": { "type": "number", "minimum": 0.1, "maximum": 10.0 },
                  "word_ids": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "is_muted": { "type": "boolean" }
                }
              }
            }
          }
        },
        "audio_track": {
          "type": "object",
          "required": ["ducking_enabled", "bleeps"],
          "properties": {
            "ducking_enabled": { "type": "boolean" },
            "ducking_db": { "type": "number" },
            "background_music": {
              "type": ["object", "null"],
              "properties": {
                "music_url": { "type": "string" },
                "volume": { "type": "number" }
              }
            },
            "bleeps": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["word_id", "frequency_hz"],
                "properties": {
                  "word_id": { "type": "string" },
                  "frequency_hz": { "type": "integer" }
                }
              }
            }
          }
        },
        "caption_track": {
          "type": "object",
          "required": ["captions"],
          "properties": {
            "captions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "text", "anchor_word_ids", "is_active", "style"],
                "properties": {
                  "id": { "type": "string" },
                  "text": { "type": "string" },
                  "anchor_word_ids": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "is_active": { "type": "boolean" },
                  "style": {
                    "type": "object",
                    "properties": {
                      "color": { "type": "string" },
                      "font_size": { "type": "integer" },
                      "position": { "type": "string" }
                    }
                  },
                  "min_duration_s": { "type": "number" }
                }
              }
            }
          }
        }
      }
    },
    "edit_history": {
      "type": "object",
      "required": ["history_steps", "undo_pointer"],
      "properties": {
        "history_steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["step_id", "op_type", "instruction_text", "timestamp"],
            "properties": {
              "step_id": { "type": "string" },
              "op_type": { "type": "string" },
              "instruction_text": { "type": "string" },
              "params": { "type": "object" },
              "timestamp": { "type": "string", "format": "date-time" }
            }
          }
        },
        "undo_pointer": { "type": "integer", "minimum": -1 }
      }
    },
    "derived_timing": {
      "type": "object",
      "required": ["total_duration_s", "active_clip_count", "timeline_hash"],
      "properties": {
        "total_duration_s": { "type": "number", "minimum": 0 },
        "active_clip_count": { "type": "integer", "minimum": 0 },
        "timeline_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}

