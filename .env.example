# IncuBrix Prompt-Based Video Editing Engine Configuration

# Service Settings
PORT=8000
HOST=0.0.0.0
DEBUG=false
ENVIRONMENT=production
API_V1_PREFIX=/api/v1
APP_NAME=IncuBrix-Prompt-Editing-Engine
APP_VERSION=1.0.0

# Security & Retries
IDEMPOTENCY_TTL_SECONDS=86400
HMAC_SECRET_KEY=incubrix-secure-signature-secret-key-32ch
WEBHOOK_TIMEOUT_SECONDS=10

# Storage Settings (Local / S3 / MinIO)
STORAGE_BACKEND=local
STORAGE_DIR=./data/storage
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=incubrix-video-edits
S3_PUBLIC_BASE_URL=http://localhost:9000/incubrix-video-edits

# Speech-To-Text (STT) Settings
# Options: mock, whisper_local, whisper_api
STT_PROVIDER=mock
STT_MODEL_NAME=whisper-base
STT_CONFIDENCE_THRESHOLD=0.60
STT_SILENCE_THRESHOLD_SECONDS=0.70
STT_SNAP_MARGIN_SECONDS=0.05

# Language Model / NLP Parser Settings
# Options: mock, rule_based, openai, gemini
LLM_PROVIDER=rule_based
LLM_MODEL_NAME=deterministic-rule-engine
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=512
OPENAI_API_KEY=
GEMINI_API_KEY=

# Timeline & Engine Policies
DEFAULT_TIME_POLICY=original_media_time
MAX_SPEED_FACTOR=4.0
MIN_SPEED_FACTOR=0.25
MIN_READABLE_CAPTION_DURATION_S=0.70
AUDIO_DUCKING_DB=-18.0
BLEEP_FREQUENCY_HZ=1000

# Concurrency & Execution Limits
MAX_VIDEO_DURATION_SECONDS=3600
MAX_UPLOAD_SIZE_BYTES=1073741824
JOB_WORKER_CONCURRENCY=4
FFMPEG_THREADS=0

